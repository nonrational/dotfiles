# Copy to .statusline.local and fill in your values.
# This file is gitignored; the example is tracked.

# Monthly spend budget in USD. When set, MTD cost displays as a % of this limit.
MONTHLY_BUDGET=

# To seed mid-month spend (e.g. before you installed the hook), append one or
# more entries to ~/.claude/session-costs.jsonl manually:
#
#   echo '{"date":"2026-08-01","session":"seed","cost":42.00}' >> ~/.claude/session-costs.jsonl
#
# The month resets automatically: the statusline filters by YYYY-MM prefix, so
# entries from prior months fall out of the total on the first of each month.
